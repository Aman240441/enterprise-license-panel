# Application Settings
APP_NAME="Enterprise License Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
API_BASE_URL=https://your-domain.com/api/v1
APP_TIMEZONE=UTC

# Database Configuration (PostgreSQL or MySQL)
DB_DRIVER=pgsql
DATABASE_URL=postgres://username:password@localhost:5432/enterprise_license_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=enterprise_license_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_SSL_MODE=prefer

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters
JWT_ALGO=HS256
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Security Settings
CSRF_TOKEN_NAME=elms_csrf_token
ARGON2_TIME_COST=4
ARGON2_MEMORY_COST=65536
ARGON2_THREADS=2
CORS_ALLOWED_ORIGINS=*

# Storage Configuration (local, supabase, s3, r2)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=license-uploads

# System Defaults
DEFAULT_LICENSE_PREFIX=GB
DEFAULT_EXPIRY_DAYS=30
RATE_LIMIT_PER_MINUTE=120
